{
  "name": "arcade-racer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:visual": "playwright test tests/visual.spec.ts",
    "test:drift": "playwright test tests/drift.spec.ts",
    "test:bot": "playwright test tests/bot-playtest.spec.ts --project=desktop-chrome",
    "inspect:canvas": "node scripts/inspect-threejs-canvas.mjs",
    "capture:states": "node scripts/capture-states.mjs",
    "verify:production": "node scripts/verify-production.mjs",
    "verify:all": "npm run typecheck && npm run build && npm run test",
    "diagnose:steering": "node scripts/diagnose-steering.mjs"
  },
  "dependencies": {
    "lil-gui": "^0.21.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.0",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.184.1",
    "pngjs": "^7.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.13"
  },
  "description": "Drift Circuit \u2014 a browser 3D time-attack racer built on three.js"
}
